@model IEnumerable<IMS_Dashboard.ViewModels.UserVM.DisplayUserViewModel>

@{
    ViewData["Title"] = "User List";
}

<div class="col-lg-12 grid-margin stretch-card">
    <div class="card">
        <div class="card-body">
            <h4 class="card-title">@ViewData["Title"]</h4>

            <div class="table-responsive pt-3">

                <table class="table table-bordered">
                    <thead>
                        <tr>
                            <th> # </th>
                            <th> @Html.DisplayNameFor(model => model.name) </th>
                            <th> @Html.DisplayNameFor(model => model.user_name) </th>
                            <th> @Html.DisplayNameFor(model => model.role) </th>
                            <th class="tdcontrol"></th>
                            <th class="tdcontrol"></th>
                        </tr>
                    </thead>
                    <tbody id="inventoryTableBody">
                        @if (Model != null)
                        {
                            int rowNumber = 1;
                            @foreach (var user in Model)
                            {
                                <tr data-id="@user.id">
                                    <td> @rowNumber </td>
                                    <td> @user.name </td>
                                    <td> @user.user_name </td>
                                    <td> @user.role </td>
                                    <td class="tdcontrol">
                                        <form asp-action="EditUser" method="get">
                                            <input type="hidden" name="id" value="@user.id" />
                                            <button type="submit" class="btn btn-warning btn-sm">Edit</button>
                                        </form>
                                    </td>
                                    <td class="tdcontrol">
                                        <form asp-action="DeleteUser" method="post">
                                            <input type="hidden" name="id" value="@user.id" />
                                            <button type="submit" class="btn btn-danger btn-sm">Delete</button>
                                        </form>
                                    </td>
                                </tr>
                                rowNumber++;
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
