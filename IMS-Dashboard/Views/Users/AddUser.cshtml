@model IMS_Dashboard.ViewModels.UserVM.AddUserViewModel

<div class="col-12 grid-margin stretch-card">
    <div class="card">
        <div class="card-body">
            <h4 class="card-title">Create User</h4>

            <form asp-action="AddUser" class="forms-sample" method="post" enctype="multipart/form-data" autocomplete="off">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group row">
                            <label asp-for="name" class="control-label"></label>
                            <div class="col-sm-9">
                                <input asp-for="name" type="text" class="form-control"
                                       placeholder="Enter name of user.." id="name">
                                <span asp-validation-for="name" class="text-danger"></span>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group row">
                            <label asp-for="username" class="control-label"></label>
                            <div class="col-sm-9">
                                <input asp-for="username" type="text" class="form-control"
                                       placeholder="Enter username.." id="username" autocomplete="new-username">
                                <span asp-validation-for="username" class="text-danger"></span>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group row">
                            <label asp-for="password" class="control-label"></label>
                            <div class="col-sm-9">
                                <input asp-for="password" type="password" class="form-control"
                                       placeholder="Enter password.." id="password" autocomplete="new-password">
                                <span asp-validation-for="password" class="text-danger"></span>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group row">
                            <label asp-for="role_id" class="control-label"></label>
                            <div class="col-sm-9">
                                <select class="form-select" asp-for="role_id" asp-items="@Model.Roles"></select>
                                <span asp-validation-for="role_id" class="text-danger"></span>
                            </div>
                        </div>
                    </div>
                </div>

                <button type="submit" class="btn btn-black">Add User</button>
            </form>
        </div>
    </div>
</div>