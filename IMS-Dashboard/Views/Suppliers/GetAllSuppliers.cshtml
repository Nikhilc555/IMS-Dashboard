@model IEnumerable<IMS_Dashboard.ViewModels.SuppliersVM.DisplaySupplierViewModel>

@{
    ViewData["Title"] = "Supplier List";
}

<div class="col-lg-12 grid-margin stretch-card">
    <div class="card">
        <div class="card-body">
            <h4 class="card-title">@ViewData["Title"]</h4>
            @* <p class="card-description">
            Add class <code>.table-bordered</code>
            </p> *@
            <div class="table-responsive pt-3">
                <table class="table table-bordered">
                    <thead>
                        <tr>
                            <th> # </th>
                            <th> @Html.DisplayNameFor(model => model.shipment_mark) </th>
                            <th> @Html.DisplayNameFor(model => model.supplier_name) </th>
                            <th> @Html.DisplayNameFor(model => model.ContactName) </th>
                            <th> @Html.DisplayNameFor(model => model.PhoneNumber) </th>
                            <th> @Html.DisplayNameFor(model => model.Email) </th>
                            <th> @Html.DisplayNameFor(model => model.Address) </th>
                            <th class="tdcontrol"></th>
                            <th class="tdcontrol"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null)
                        {
                            int rowNumber = 1;
                            @foreach (var suppliers in Model)
                            {
                                <tr>
                                    <td> @rowNumber </td>
                                    <td> @suppliers.shipment_mark </td>
                                    <td> @suppliers.supplier_name </td>
                                    <td> @suppliers.ContactName </td>
                                    <td> @suppliers.PhoneNumber </td>
                                    <td> @suppliers.Email </td>
                                    <td> @suppliers.Address</td>
                                    <td class="tdcontrol">
                                        <form asp-action="EditSupplier" method="get">
                                            <input type="hidden" name="id" value="@suppliers.id" />
                                            <button type="submit" class="btn btn-warning btn-sm">Edit</button>
                                        </form>
                                    </td>
                                    <td class="tdcontrol">
                                        <form asp-action="DeleteSupplier" method="post">
                                            <input type="hidden" name="id" value="@suppliers.id" />
                                            <button type="submit" class="btn btn-danger btn-sm">Delete</button>
                                        </form>
                                    </td>
                                </tr>
                                rowNumber++;
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>