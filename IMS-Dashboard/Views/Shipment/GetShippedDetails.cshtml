@model IMS_Dashboard.ViewModels.ShipmentVM.GetAllShipmentViewModel

@{
    ViewData["Title"] = "Completed Shipment";
    var from_date = Model?.from_date ?? "";
    var to_date = Model?.to_date ?? "";
}

<div class="col-lg-12 grid-margin stretch-card">
    <div class="card">
        <div class="card-body">
            <h4 class="card-title">@ViewData["Title"]</h4>
            @* <p class="card-description">
            Add class <code>.table-bordered</code>
            </p> *@
            <form class="search-form" asp-controller="Shipment" asp-action="GetShippedDetails" method="get">
                <div class="col-md-12 row">
                    <div class="col-md-4">
                        @* <label for="ShippingRef" class="control-label"></label> *@
                        <select asp-for="ShippingRef" asp-items="Model.ShippingRefOptions" class="form-control" style="color:black;" onchange="this.form.submit();">
                            <option value="">Select Shipping Reference</option>
                        </select>
                        <span validation-for="ShippingRef" class="text-danger"></span>
                    </div>
                    <div class="col-md-2">
                        <div id="from_date" class="input-group date datepicker navbar-date-picker">
                            <span class="input-group-addon input-group-prepend border-right">
                                <span class="icon-calendar input-group-text calendar-icon"></span>
                            </span>
                            <input type="text" name="from_date" class="form-control" placeholder="yyyy-MM-dd" value="@from_date">
                        </div>
                    </div>
                    <div class="col-md-2">
                        <div id="to_date" class="input-group date datepicker navbar-date-picker">
                            <span class="input-group-addon input-group-prepend border-right">
                                <span class="icon-calendar input-group-text calendar-icon"></span>
                            </span>
                            <input type="text" name="to_date" class="form-control" placeholder="yyyy-MM-dd" value="@to_date">
                        </div>
                    </div>
                    <div class="col-md-4">

                        <button type="submit" class="btn btn-black"><i class="icon-search"></i></button>
                        <button type="button" id="downloadExcel" style="float:right;" class="btn btn-black">Download Excel</button>
                    </div>
                    @* <div class="col-md-2">
                        <button type="button" class="btn btn-success" style="float:right;" onclick="window.location.href='@Url.Action("AddInventory", "Inventories")'">
                            ADD
                        </button>
                    </div> *@
                </div>
            </form>
            <div class="table-responsive pt-3">
                <table id="ShippedDetails" class="table table-bordered download-table">
                    <thead>
                        <tr>
                            <th> # </th>
                            @* <th class="shipped"> @Html.DisplayNameFor(model => model.ShippingRef) </th> *@
                            <th> @Html.DisplayNameFor(model => model.Inventory.First().CTNNo) </th>
                            <th> @Html.DisplayNameFor(model => model.Inventory.First().ShippingMark) </th>
                            @* <th> @Html.DisplayNameFor(model => model.Product) </th> *@
                            @* <th> @Html.DisplayNameFor(model => model.Supplier) </th> *@
                            <th> @Html.DisplayNameFor(model => model.Inventory.First().Description) </th>
                            <th> @Html.DisplayNameFor(model => model.Inventory.First().Quantity) </th>
                            <th> @Html.DisplayNameFor(model => model.Inventory.First().Weight) </th>
                            <th class="shipped"> @Html.DisplayNameFor(model => model.Inventory.First().CreatedOn) </th>
                            <th class="shipped"> @Html.DisplayNameFor(model => model.Inventory.First().Created_by) </th>
                            <th class="shipped"> @Html.DisplayNameFor(model => model.Inventory.First().ShippedOn) </th>
                            <th class="shipped"> @Html.DisplayNameFor(model => model.Inventory.First().Shipped_by) </th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null)
                        {
                            int rowNumber = 1;
                            @foreach (var inventory in Model.Inventory)
                            {
                                <tr>
                                    <td> @rowNumber </td>
                                    @* <td class="shipped"> @inventory.ShippingRef </td> *@
                                    <td> @inventory.CTNNo </td>
                                    <td> @inventory.ShippingMark </td>
                                    @* <td> @inventory.Product </td> *@
                                    @* <td> @inventory.Supplier </td> *@
                                    <td> @inventory.Description </td>
                                    <td> @inventory.Quantity </td>
                                    <td> @inventory.Weight </td>
                                    <td class="shipped"> @inventory.CreatedOn </td>
                                    <td class="shipped"> @inventory.Created_by </td>
                                    <td class="shipped"> @inventory.ShippedOn </td>
                                    <td class="shipped"> @inventory.Shipped_by </td>
                                </tr>
                                rowNumber++;
                            }
                            if(rowNumber == 1)
                            {
                                <tr>
                                    <td colspan="10">No data found</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
