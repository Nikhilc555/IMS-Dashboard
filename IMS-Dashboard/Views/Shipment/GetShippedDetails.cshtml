@model IEnumerable<IMS_Dashboard.ViewModels.ShipmentVM.ShipmentViewModel>

@{
    ViewData["Title"] = "Shipped Details";
    var from_date = Model?.FirstOrDefault()?.from_date ?? DateTime.Today.ToString("yyyy-MM-dd");
    var to_date = Model?.FirstOrDefault()?.to_date ?? DateTime.Today.ToString("yyyy-MM-dd");
}

<div class="col-lg-12 grid-margin stretch-card">
    <div class="card">
        <div class="card-body">
            <h4 class="card-title">@ViewData["Title"]</h4>
            @* <p class="card-description">
            Add class <code>.table-bordered</code>
            </p> *@
            <form class="search-form" asp-controller="Shipment" asp-action="GetShippedDetails" method="get">
                <div class="col-md-12 row">
                    <div class="col-md-4">
                        <div id="from_date" class="input-group date datepicker navbar-date-picker">
                            <span class="input-group-addon input-group-prepend border-right">
                                <span class="icon-calendar input-group-text calendar-icon"></span>
                            </span>
                            <input type="text" name="from_date" class="form-control" value="@from_date">
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div id="to_date" class="input-group date datepicker navbar-date-picker">
                            <span class="input-group-addon input-group-prepend border-right">
                                <span class="icon-calendar input-group-text calendar-icon"></span>
                            </span>
                            <input type="text" name="to_date" class="form-control" value="@to_date">
                        </div>
                    </div>
                    <div class="col-md-2">

                        <button type="submit" class="btn btn-primary"><i class="icon-search"></i></button>
                        <button type="button" id="downloadExcel" class="btn btn-primary">Excel</button>
                    </div>
                    @* <div class="col-md-2">
                        <button type="button" class="btn btn-success" style="float:right;" onclick="window.location.href='@Url.Action("AddInventory", "Inventories")'">
                            ADD
                        </button>
                    </div> *@
                </div>
            </form>
            <div class="table-responsive pt-3">
                <table id="ShippedDetails" class="table table-bordered download-table">
                    <thead>
                        <tr>
                            <th> # </th>
                            <th> @Html.DisplayNameFor(model => model.ShippingRef) </th>
                            <th> @Html.DisplayNameFor(model => model.CTNNo) </th>
                            <th> @Html.DisplayNameFor(model => model.ShippingMark) </th>
                            <th> @Html.DisplayNameFor(model => model.Product) </th>
                            <th> @Html.DisplayNameFor(model => model.Supplier) </th>
                            <th> @Html.DisplayNameFor(model => model.Quantity) </th>
                            <th> @Html.DisplayNameFor(model => model.Weight) </th>
                            <th> @Html.DisplayNameFor(model => model.CreatedOn) </th>
                            <th> @Html.DisplayNameFor(model => model.Created_by) </th>
                            <th> @Html.DisplayNameFor(model => model.ShippedOn) </th>
                            <th> @Html.DisplayNameFor(model => model.Shipped_by) </th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null)
                        {
                            int rowNumber = 1;
                            @foreach (var inventory in Model)
                            {
                                <tr>
                                    <td> @rowNumber </td>
                                    <td> @inventory.ShippingRef </td>
                                    <td> @inventory.CTNNo </td>
                                    <td> @inventory.ShippingMark </td>
                                    <td> @inventory.Product </td>
                                    <td> @inventory.Supplier </td>
                                    <td> @inventory.Quantity </td>
                                    <td> @inventory.Weight </td>
                                    <td> @inventory.CreatedOn </td>
                                    <td> @inventory.Created_by </td>
                                    <td> @inventory.ShippedOn </td>
                                    <td> @inventory.Shipped_by </td>
                                </tr>
                                rowNumber++;
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
