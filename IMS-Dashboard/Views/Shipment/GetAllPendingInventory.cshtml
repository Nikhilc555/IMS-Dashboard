@model IEnumerable<IMS_Dashboard.ViewModels.InventoryVM.GetAllInventoryViewModel>

@{
    ViewData["Title"] = "Current Stock";
}

<div class="col-lg-12 grid-margin stretch-card">
    <div class="card">
        <div class="card-body">
            <h4 class="card-title">@ViewData["Title"]</h4>
            @* <p class="card-description">
            Add class <code>.table-bordered</code>
            </p> *@
            <div class="col-md-12 row">
                <div class="col-md-8"></div>
                <div class="col-md-4">
                    <button type="button" id="downloadExcel" style="float:right;" class="btn btn-primary">Excel</button>
                    <button type="button" class="btn btn-success" style="float:right;" onclick="window.location.href='@Url.Action("GetInventoryForShipping", "Shipment")'">
                        Ship Inventory
                    </button>
                </div>
            </div>
            <div class="table-responsive pt-3">
                <table id="PendingInventory" class="table table-bordered download-table">
                    <thead>
                        <tr>
                            <th> # </th>
                            <th> @Html.DisplayNameFor(model => model.CTNNo) </th>
                            <th> @Html.DisplayNameFor(model => model.ShippingMark) </th>
                            <th> @Html.DisplayNameFor(model => model.Product) </th>
                            <th> @Html.DisplayNameFor(model => model.Supplier) </th>
                            <th> @Html.DisplayNameFor(model => model.Quantity) </th>
                            <th> @Html.DisplayNameFor(model => model.Weight) </th>
                            <th> @Html.DisplayNameFor(model => model.CreatedOn) </th>
                            <th> @Html.DisplayNameFor(model => model.Created_by) </th>
                            <th class="edit"></th>
                            <th class="delete"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null)
                        {
                            int rowNumber = 1;
                            @foreach (var inventory in Model)
                            {
                                <tr>
                                    <td> @rowNumber </td>
                                    <td> @inventory.CTNNo </td>
                                    <td> @inventory.ShippingMark </td>
                                    <td> @inventory.Product </td>
                                    <td> @inventory.Supplier </td>
                                    <td> @inventory.Quantity </td>
                                    <td> @inventory.Weight </td>
                                    <td> @inventory.CreatedOn </td>
                                    <td> @inventory.Created_by </td>
                                    <td> <button type="button" class="btn btn-warning btn-sm edit-inventory">Edit</button> </td>
                                    <td> <button type="button" class="btn btn-danger btn-sm delete-inventory">Delete</button> </td>
                                </tr>
                                rowNumber++;
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
